<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PetManager_Admin_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F1F3F7" Padding="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="PageTitle" Text="관리자 페이지" Foreground="#101A31"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="PageDescription" Text="관리자 전용 앱"
                           Foreground="#64748B" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1" Content="새로고침" Height="44" MinWidth="96"
                    Padding="14,0" Background="White" Foreground="#101A31"
                    BorderBrush="#E8EDF3" Click="RefreshButton_Click" />
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="10">
            <WebView2 x:Name="PetManagerWebView" />
        </Border>
    </Grid>
</Page>
