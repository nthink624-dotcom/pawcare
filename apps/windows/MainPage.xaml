<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PetManager_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#F1F3F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="White" Padding="20,24,16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="10" Background="#111A30">
                    <TextBlock Text="P" Foreground="White" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="펫매니저" Foreground="#101A31" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="오너 앱" Foreground="#64748B" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="업무 화면" Foreground="#64748B" FontSize="13"
                       Margin="8,0,0,8" VerticalAlignment="Bottom" />
            <Border Grid.Row="3" Background="#EEF1F6" CornerRadius="8" Height="44" Padding="12,0">
                <TextBlock Text="매장 관리" VerticalAlignment="Center" Foreground="#101A31" FontWeight="SemiBold" />
            </Border>
            <TextBlock Grid.Row="5" Text="예약과 매장 업무를 관리하세요."
                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                       Margin="8,0,8,2" />
        </Grid>
        <Grid Grid.Column="1" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="PageTitle" Text="매장 관리" Foreground="#101A31"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageDescription" Text="예약과 매장 업무를 관리하세요."
                               Foreground="#64748B" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PushButton" Content="예약 알림 켜기" Height="40" MinWidth="112"
                            Padding="14,0" Background="#111A30" Foreground="White"
                            Click="PushButton_Click" />
                    <Button Content="새로고침" Height="40" MinWidth="88"
                            Padding="14,0" Background="White" Foreground="#101A31"
                            BorderBrush="#E8EDF3" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="#E8EDF3" BorderThickness="1" CornerRadius="10">
                <WebView2 x:Name="PetManagerWebView" />
            </Border>
        </Grid>
    </Grid>
</Page>
